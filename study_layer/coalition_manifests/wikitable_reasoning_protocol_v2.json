  "families": {
    "fmt": {
      "mode": "exclusive",
      "description": "Prompt layout surface. Fixed to plain."
    },
    "ser": {
      "mode": "exclusive",
      "description": "Table serialization. Fixed to JSON columns."
    },
    "contract": {
      "mode": "exclusive",
      "description": "Parser-facing final answer contract. Fixed for answer-only runs; scaffold.trace replaces it with a reasoning+final-field object."
    },
    "scaffold": {
      "mode": "exclusive",
      "description": "Visible reasoning carrier/output schema. V1 has exactly one general trace carrier."
    },
    "reason": {
      "mode": "additive",
      "description": "Reasoning style/procedure. V2 only studies these with scaffold.trace so reasoning precedes final output."
    }
  },
  "blocks": {
    "fmt.plain": {
      "family": "fmt",
      "role": "fixed_base",
      "atoms": ["prompt_format_plain"]
    },
    "ser.json_columns": {
      "family": "ser",
      "role": "fixed_base",
      "atoms": ["table_serialization_json_columns_data"]
    },
    "contract.answer_list": {
      "family": "contract",
      "role": "fixed_measurement",
      "atoms": ["output_contract_json_answer_list"]
    },
    "contract.tablebench_answer_string": {
      "family": "contract",
      "role": "fixed_measurement",
      "atoms": ["output_contract_tablebench_answer_string"]
    },
    "contract.verdict": {
      "family": "contract",
      "role": "fixed_measurement",
      "atoms": ["output_contract_json_verdict"]
    },
    "scaffold.trace": {
      "family": "scaffold",
      "role": "visible_reasoning_trace_carrier",
      "excludes_families": ["contract"],
      "atoms": ["reasoning_scaffold_visible_cot"]
    },
    "reason.extract_compute": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_extract_then_compute"]
    },
    "reason.filter_answer": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_evidence_localization"]
    },
    "reason.enumerate": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_candidate_enumeration"]
    },
    "reason.evidence_table": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_intermediate_evidence_table"]
    },
    "reason.symbolic_op": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_symbolic_operation"]
    },
    "reason.verify": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_verify_before_output"]
    },
    "reason.operation_select": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_plan_then_answer"]
    },
    "reason.critique_revise": {
      "family": "reason",
      "role": "private_reasoning_style",
      "atoms": ["reasoning_critique_then_revise"]
    }
  },
  "generation": {
    "main_blocks": [
      "scaffold.trace"
    ],
    "cartesian": [
