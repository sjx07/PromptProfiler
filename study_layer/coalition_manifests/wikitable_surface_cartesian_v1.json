  "families": {
    "fmt": {
      "mode": "exclusive",
      "description": "Prompt formatting surface. V1 keeps only plain and JSON; markdown/yaml/code-block were noisy or harmful in WTQ."
    },
    "ser": {
      "mode": "exclusive",
      "description": "Table serialization. Exactly one table view is active."
    },
    "contract": {
      "mode": "exclusive",
      "description": "Benchmark scoring contract, fixed by task."
    },
    "ctx": {
      "mode": "exclusive",
      "description": "Deterministic input-context builder. V1 treats composite builders as mutually exclusive matrix levels."
    }
  },
  "blocks": {
    "fmt.plain": {
      "family": "fmt",
      "role": "fixed_base",
      "atoms": ["prompt_format_plain"]
    },
    "fmt.json": {
      "family": "fmt",
      "role": "screen",
      "atoms": ["prompt_format_json"]
    },
    "ser.json_columns": {
      "family": "ser",
      "role": "fixed_base",
      "atoms": ["table_serialization_json_columns_data"]
    },
    "ser.records": {
      "family": "ser",
      "role": "screen",
      "atoms": ["table_serialization_json_records"]
    },
    "ser.html": {
      "family": "ser",
      "role": "screen",
      "atoms": ["table_serialization_html"]
    },
    "contract.json_list": {
      "family": "contract",
      "role": "fixed_measurement",
      "atoms": ["output_contract_json_answer_list"]
    },
    "ctx.type": {
      "family": "ctx",
      "role": "screen",
      "atoms": ["input_context_type_annotation"]
    },
    "ctx.stats": {
      "family": "ctx",
      "role": "screen",
      "atoms": ["input_context_column_statistics"]
    },
    "ctx.type_stats": {
      "family": "ctx",
      "role": "screen",
      "atoms": [
        "input_context_type_annotation",
        "input_context_column_statistics"
      ]
    },
    "ctx.cols12": {
      "family": "ctx",
      "role": "screen",
      "atoms": ["input_context_column_selection_relevance_12"]
    },
    "ctx.rows50": {
      "family": "ctx",
      "role": "screen",
      "atoms": ["input_context_row_selection_relevance_50"]
    },
    "ctx.relevant_table": {
      "family": "ctx",
      "role": "screen",
      "atoms": [
        "input_context_column_selection_relevance_12",
        "input_context_row_selection_relevance_50"
      ]
    },
    "ctx.full": {
      "family": "ctx",
      "role": "screen",
      "atoms": [
        "input_context_type_annotation",
        "input_context_column_statistics",
        "input_context_column_selection_relevance_12",
        "input_context_row_selection_relevance_50"
      ]
    }
  },
  "generation": {
    "main_blocks": [
      "fmt.json",
      "ser.records",
      "ser.html"
    ],
    "pairwise": [
      {
        "name": "format_serialization_no_context",
        "left": ["fmt.json"],
        "right": ["ser.records", "ser.html"]
      }
    ],
    "cartesian": [
      {
        "name": "surface_matrix",
        "groups": [
          ["fmt.plain", "fmt.json"],
          ["ser.json_columns", "ser.records", "ser.html"],
          [
            "ctx.type",
            "ctx.stats",
            "ctx.type_stats",
            "ctx.cols12",
            "ctx.rows50",
            "ctx.relevant_table",
            "ctx.full"
          ]
        ]
      }
    ]
  }
}
